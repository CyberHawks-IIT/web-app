@{
    ViewData["Title"] = "Sign In";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="ch-auth-wrap">
    <div class="ch-center" style="margin-bottom:20px">
        <h1 style="font-size:26px;margin-bottom:4px">Member Sign In</h1>
        <p class="ch-muted">Please identify yourself to the Office of Veneration.</p>
    </div>

    @if (ViewData["Error"] != null)
    {
        <div class="ch-alert err">@ViewData["Error"]</div>
    }

    <form class="ch-form" method="post" asp-controller="Account" asp-action="Login">
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <div class="ch-field">
            <label>Username</label>
            <input type="text" name="username" autofocus required />
        </div>
        <div class="ch-field">
            <label>Password</label>
            <input type="password" name="password" required />
        </div>
        <button type="submit" class="ch-btn ch-btn-primary" style="width:100%;justify-content:center">Sign In</button>
        <div class="ch-center" style="margin-top:14px;font-size:13.5px">
            <a asp-action="ForgotPassword">Forgot your password?</a> ·
            <a asp-action="Register">Join the club</a>
        </div>
    </form>
    <p class="ch-foot ch-center">Transmitted with the utmost care over an entirely ordinary connection.</p>
</div>
