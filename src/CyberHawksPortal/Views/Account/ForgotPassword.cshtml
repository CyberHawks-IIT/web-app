@{
    ViewData["Title"] = "Forgot Password";
    var resetLink = ViewData["ResetLink"] as string;
}

<div class="ch-auth-wrap">
    <div class="ch-center" style="margin-bottom:20px">
        <h1 style="font-size:26px;margin-bottom:4px">Password Recovery</h1>
        <p class="ch-muted">Even the most devoted occasionally forget. We forgive you.</p>
    </div>

    @if (ViewData["Error"] != null) { <div class="ch-alert err">@ViewData["Error"]</div> }
    @if (ViewData["Ok"] != null) { <div class="ch-alert ok">@ViewData["Ok"]</div> }

    @if (resetLink != null)
    {
        <div class="ch-alert info">
            Our mail server is, regrettably, on sabbatical. Here is your reset link directly:<br />
            <a href="@resetLink" style="word-break:break-all">@resetLink</a>
        </div>
    }

    <form class="ch-form" method="post" asp-controller="Account" asp-action="ForgotPassword">
        <div class="ch-field">
            <label>Username</label>
            <input type="text" name="username" required autofocus />
        </div>
        <button type="submit" class="ch-btn ch-btn-primary" style="width:100%;justify-content:center">Send reset link</button>
        <div class="ch-center" style="margin-top:14px;font-size:13.5px">
            <a asp-action="Login">Back to sign in</a>
        </div>
    </form>
</div>
