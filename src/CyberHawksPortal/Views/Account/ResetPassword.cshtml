@{
    ViewData["Title"] = "Reset Password";
    var token = ViewData["Token"] as string;
}

<div class="ch-auth-wrap">
    <div class="ch-center" style="margin-bottom:20px">
        <h1 style="font-size:26px;margin-bottom:4px">Choose a New Password</h1>
        <p class="ch-muted">A fresh start, cryptographically speaking.</p>
    </div>

    @if (ViewData["Error"] != null) { <div class="ch-alert err">@ViewData["Error"]</div> }
    @if (ViewData["Ok"] != null)
    {
        <div class="ch-alert ok">@ViewData["Ok"]</div>
        <div class="ch-center"><a class="ch-btn ch-btn-primary" asp-action="Login">Sign in</a></div>
    }
    else
    {
        <form class="ch-form" method="post" asp-controller="Account" asp-action="ResetPassword">
            <input type="hidden" name="token" value="@token" />
            <div class="ch-field">
                <label>New password</label>
                <input type="password" name="password" required autofocus />
            </div>
            <button type="submit" class="ch-btn ch-btn-primary" style="width:100%;justify-content:center">Reset password</button>
        </form>
    }
</div>
