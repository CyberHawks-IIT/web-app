@{
    var user = Context.Items["CurrentUser"] as CyberHawksPortal.Models.User;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · CyberHawks Member Portal</title>
    <link rel="icon" type="image/svg+xml" href="~/img/triceratops.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <header class="ch-header">
        <div class="ch-topbar">
            <div class="ch-container ch-topbar-inner">
                <span>Illinois Institute of Technology · Student Cybersecurity Organization</span>
                <span class="ch-topbar-right">
                    <a href="https://cyberhawks.iit.edu" target="_blank" rel="noopener">cyberhawks.iit.edu</a>
                    <span class="ch-dot">•</span>
                    <a asp-controller="Account" asp-action="Login">Member Sign In</a>
                </span>
            </div>
        </div>
        <nav class="ch-nav">
            <div class="ch-container ch-nav-inner">
                <a class="ch-brand" asp-controller="Home" asp-action="Index">
                    <span class="ch-brand-mark" aria-hidden="true">
                        <svg viewBox="0 0 48 48" width="38" height="38" role="img" aria-label="CyberHawks lock">
                            <path d="M24 3 L40 9 V22 C40 33 33 41 24 45 C15 41 8 33 8 22 V9 Z" fill="#C8102E"/>
                            <path d="M24 6.5 L36.6 11.2 V22 C36.6 31.2 30.8 38 24 41.4 C17.2 38 11.4 31.2 11.4 22 V11.2 Z" fill="#9b0c23"/>
                            <path d="M24 16 c-3.4 0-5.3 2.1-5.3 2.1 l2.4 1 l-3 1.2 l2.4 1.1 l-2.6 1.3 c0 0 2.6 3.9 9.1 3.9 c2.9 0 5-1.1 6.3-2.3 l-4.6-1.1 l3.2-1.4 l-3.4-1.1 l2.9-1.3 C32 16.9 28.2 16 24 16 Z" fill="#fff"/>
                            <rect x="21.4" y="27" width="5.2" height="9" rx="2.6" fill="#fff"/>
                        </svg>
                    </span>
                    <span class="ch-brand-text">
                        <strong>CyberHawks</strong>
                        <small>Member Portal</small>
                    </span>
                </a>

                <button class="ch-nav-toggle" type="button" aria-label="Menu"
                        onclick="document.querySelector('.ch-nav-links').classList.toggle('open')">☰</button>

                <div class="ch-nav-links">
                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <a asp-controller="Home" asp-action="About">About</a>
                    <a asp-controller="Competitions" asp-action="Index">Competitions</a>
                    <a asp-controller="News" asp-action="Index">News</a>
                    <a asp-controller="Members" asp-action="Index">Members</a>
                    <a asp-controller="Documents" asp-action="Index">Documents</a>
                    <a asp-controller="Sponsors" asp-action="Index">Sponsors</a>

                    <form class="ch-search" asp-controller="Search" asp-action="Index" method="get" role="search">
                        <input type="search" name="q" placeholder="Search the portal…" aria-label="Search" />
                        <button type="submit" aria-label="Search">⌕</button>
                    </form>

                    @if (user != null)
                    {
                        <div class="ch-user-menu">
                            <a class="ch-btn ch-btn-ghost" asp-controller="Members" asp-action="Details" asp-route-id="@user.UserId">@user.FirstName</a>
                            <a class="ch-btn ch-btn-primary" asp-controller="Account" asp-action="Logout">Sign Out</a>
                        </div>
                    }
                    else
                    {
                        <div class="ch-user-menu">
                            <a class="ch-btn ch-btn-ghost" asp-controller="Account" asp-action="Register">Join</a>
                            <a class="ch-btn ch-btn-primary" asp-controller="Account" asp-action="Login">Sign In</a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main class="ch-main">
        @RenderBody()
    </main>

    <footer class="ch-footer">
        <div class="ch-container ch-footer-grid">
            <div class="ch-footer-brand">
                <div class="ch-footer-logo">🔒 CyberHawks</div>
                <p>Illinois Tech's student cybersecurity organization. Hands-on offense &amp;
                   defense, national competitions, and a community of hackers and builders.</p>
                <p class="ch-muted">Established 2018 · Founded, led, and eternally venerated:
                    <a href="#" data-david style="color:#c7cdd8;text-decoration:underline dotted">David Arnold</a></p>
            </div>
            <div>
                <h4>Explore</h4>
                <ul>
                    <li><a asp-controller="Home" asp-action="About">About the Club</a></li>
                    <li><a asp-controller="Competitions" asp-action="Index">Competition Teams</a></li>
                    <li><a asp-controller="News" asp-action="Index">News &amp; Seminars</a></li>
                    <li><a asp-controller="Members" asp-action="Index">Member Roster</a></li>
                </ul>
            </div>
            <div>
                <h4>Members</h4>
                <ul>
                    <li><a asp-controller="Account" asp-action="Login">Sign In</a></li>
                    <li><a asp-controller="Account" asp-action="Register">Join the Club</a></li>
                    <li><a asp-controller="Sponsors" asp-action="Index">Our Sponsors</a></li>
                    <li><a asp-controller="Home" asp-action="About">Leadership</a></li>
                </ul>
            </div>
            <div>
                <h4>Campus</h4>
                <p class="ch-muted">
                    Siegel Hall, ECE Department<br/>
                    3301 S Dearborn St<br/>
                    Chicago, IL 60616
                </p>
            </div>
        </div>
        <div class="ch-funfact-strip">
            <div class="ch-container ch-funfact-inner">
                <span class="ff-label">🎓 Fun Fact About Our Venerable Leader</span>
                <span id="ch-funfact" class="ff-text">Compiling David's accomplishments… the server has requested a moment.</span>
                <button type="button" class="ch-btn ch-btn-ghost" data-funfact>🎲 Another</button>
                <span class="ff-index">Veneration Index: <b id="ch-appreciation-count">0</b></span>
            </div>
        </div>
        <div class="ch-footer-bar">
            <div class="ch-container ch-footer-bar-inner">
                <span>© @DateTime.Now.Year CyberHawks @@ Illinois Institute of Technology.
                    For internal club use. Greatness not guaranteed but strongly implied.</span>
                <span class="ch-footer-trike" title="Pet the mascot" data-trike style="cursor:pointer">
                    <img src="~/img/triceratops.svg" width="22" height="22" alt="mascot" /> Trike-approved
                </span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/portal.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
